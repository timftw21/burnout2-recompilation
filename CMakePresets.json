{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/windows",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_LINKER_TYPE": "LLD"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "windows", "configuration": "Release", "jobs": 6 },
    { "name": "debug", "configurePreset": "windows", "configuration": "Debug", "jobs": 6 }
  ]
}
