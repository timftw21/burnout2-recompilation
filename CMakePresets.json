{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "environment": { "MSBUILDDISABLENODEREUSE": "1" },
      "binaryDir": "${sourceDir}/build/windows"
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "windows", "configuration": "Release", "jobs": 2, "nativeToolOptions": ["/nodeReuse:false"] },
    { "name": "debug", "configurePreset": "windows", "configuration": "Debug", "jobs": 2, "nativeToolOptions": ["/nodeReuse:false"] }
  ]
}
