1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/b2.ico"
2 RCDATA "@B2_INSTALLER_PAYLOAD@"
3 RCDATA "@B2_INSTALLER_MANIFEST@"
1 VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Burnout 2 recompilation project"
      VALUE "FileDescription", "Burnout 2 Recompilation Setup"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "InternalName", "b2-setup"
      VALUE "ProductName", "Burnout 2 Recompilation"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
      VALUE "OriginalFilename", "b2-setup.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
