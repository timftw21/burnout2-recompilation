if(CMAKE_OSX_ARCHITECTURES MATCHES ";")
    message(FATAL_ERROR "Build each Mac architecture separately; the native generator must run on its build host.")
endif()
if(CMAKE_OSX_DEPLOYMENT_TARGET VERSION_LESS 14.0)
    message(FATAL_ERROR "The native Metal backend requires macOS 14 or newer.")
endif()
find_package(OpenSSL REQUIRED)
find_package(PNG REQUIRED)
find_package(JPEG REQUIRED)
find_package(Threads REQUIRED)
find_package(PkgConfig REQUIRED)
pkg_check_modules(B2_VKD3D REQUIRED IMPORTED_TARGET b2-vkd3d-shader>=2.1)
set(b2_shader_compiler_inputs ${B2_VKD3D_LINK_LIBRARIES} "${CMAKE_CURRENT_SOURCE_DIR}/cmake/vkd3d-copy-propagation.patch")
set(B2_DXMT_LLVM "" CACHE PATH "Official LLVM 15.0.7 native package used by DXMT")
find_package(LLVM 15 REQUIRED CONFIG PATHS "${B2_DXMT_LLVM}/lib/cmake/llvm" NO_DEFAULT_PATH)
if(NOT LLVM_PACKAGE_VERSION VERSION_EQUAL 15.0.7)
    message(FATAL_ERROR "DXMT's shader converter requires LLVM 15.0.7.")
endif()
foreach(option IN ITEMS SDL_STATIC SDL_TEST_LIBRARY SDL_TESTS SDL_EXAMPLES SDL_INSTALL SDL_GPU SDL_RENDER SDL_OPENGL SDL_OPENGLES SDL_VULKAN)
    set(${option} OFF CACHE BOOL "" FORCE)
endforeach()
set(SDL_SHARED ON CACHE BOOL "" FORCE)
set(SDL_METAL ON CACHE BOOL "" FORCE)
FetchContent_Declare(sdl3
    URL https://github.com/libsdl-org/SDL/archive/829a65d769d935c4852f8159e964312c0957260a.tar.gz
    URL_HASH SHA256=48E15CF1A6928453D77AFA955D1FDFBBCA9169E2BC3D76D111ACB9B8BB076D66
    DOWNLOAD_EXTRACT_TIMESTAMP FALSE)
FetchContent_MakeAvailable(sdl3)
FetchContent_Declare(dxmt
    GIT_REPOSITORY https://github.com/3Shain/dxmt.git
    GIT_TAG 9839e55f98d4aca103957ee4132d6395a325a9ed
    GIT_SUBMODULES include/native/directx)
FetchContent_MakeAvailable(dxmt)
include(cmake/dxmt.cmake)
add_library(b2-platform INTERFACE)
target_include_directories(b2-platform SYSTEM INTERFACE "${dxmt_SOURCE_DIR}/include/native/windows" "${dxmt_SOURCE_DIR}/include/native/directx")
target_link_libraries(b2-platform INTERFACE OpenSSL::Crypto Threads::Threads)
add_library(b2-d3d11 INTERFACE)
target_link_libraries(b2-d3d11 INTERFACE b2-platform b2-dxmt-d3d11 b2-dxmt-dxgi SDL3::SDL3-shared)
add_library(b2-hlsl INTERFACE)
target_link_libraries(b2-hlsl INTERFACE PkgConfig::B2_VKD3D)
